// use prisma-8
// PostgreSQL contract for Prisma ORM 8. Preserve existing table and constraint names.
model users {
  id        Int                @id @default(autoincrement())
  createdAt TimestampString(3) @default(now())
  email     String
  password  String
  lists     lists[]

  @@index([email], map: "users_email_key", unique: true)
  @@map("users")
}

model lists {
  id                 Int                  @id @default(autoincrement())
  createdAt          TimestampString(3)   @default(now())
  iconList           String?
  title              String
  userId             Int
  listsMoviesTvshows listsMoviesTvshows[]
  author             users                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

  @@map("lists")
}

model moviesTvshows {
  id                 Int                  @id @default(autoincrement())
  contentId          Int
  description        String
  pictureUrl         String
  rating             Float
  releaseYear        String
  title              String
  trailerUrl         String?
  listsMoviesTvshows listsMoviesTvshows[]

  @@index([contentId], map: "moviesTvshows_contentId_key", unique: true)
  @@map("moviesTvshows")
}

model listsMoviesTvshows {
  id            Int           @id @default(autoincrement())
  listId        Int
  movieTvshowId Int
  list          lists         @relation(fields: [listId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
  movieTvshow   moviesTvshows @relation(fields: [movieTvshowId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

  @@index([listId, movieTvshowId], map: "listsMoviesTvshows_listId_movieTvshowId_key", unique: true)
  @@map("listsMoviesTvshows")
}
